generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row = one mocked API endpoint definition.
model MockEndpoint {
  id           String   @id @default(cuid())
  path         String // e.g. /api/users/:id
  method       String // GET | POST | PUT | PATCH | DELETE
  summary      String? // short human description
  tags         String[] @default([]) // grouping, e.g. from OpenAPI tags
  params       Json     @default("[]") // [{ name, in: "query"|"path"|"header", type, required, example }]
  requestBody  Json? // example request payload
  responseBody Json? // example mock response payload
  statusCode   Int      @default(200)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([path, method])
  @@index([method])
}
